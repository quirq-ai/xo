    "/spaces/{spaceId}": {
      "get": {
        "operationId": "get_space",
        "tags": [
          "spaces"
        ],
        "summary": "Get a space's connection URLs and sharing info (owner only; URLs carry a session token)",
        "parameters": [
          {
            "name": "spaceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The id a create call returned"
          }
        ],
        "responses": {
          "200": {
            "description": "userId, spaceName, spaceApiUrl, openClawRestartUrl, sharedUsers"
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "get_me",
        "x-xo-server": true,
        "tags": [
          "users"
        ],
        "summary": "Show the account this API key belongs to (xo server)",
        "description": "Returns the key's user: id, username, first and last name, image URL, created time. Served by an xo server (`xo serve`) at $XO_URL (the default https://xo.quirq.dev), not by XO's platform.",
        "responses": {
          "200": {
            "description": "data.id, data.username, data.firstName, data.lastName, data.imageUrl, data.createdAt"
          },
          "401": {
            "description": "Bad key, or a key not tied to a user"
          },
          "429": {
            "description": "Over the per-key rate limit"
          },
          "503": {
            "description": "The xo server is misconfigured or busy"
          }
        }
      }
    },
    "/user-metadata/{userId}": {
      "get": {
        "operationId": "get_user_metadata",
        "x-xo-server": true,
        "tags": [
          "users"
        ],
        "summary": "Show a user's public and private Clerk metadata (admin keys only; xo server)",
        "description": "Admin keys only. Served by an xo server (`xo serve`) at $XO_URL (the default https://xo.quirq.dev), not by XO's platform.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A Clerk user id (user_...)"
          }
        ],
        "responses": {
          "200": {
            "description": "data.publicMetadata, data.privateMetadata"
          },
          "403": {
            "description": "The key is not an XO admin key"
          },
          "404": {
            "description": "No such user"
          },
          "422": {
            "description": "userId is not a Clerk user id"
          },
          "429": {
            "description": "Over the per-key rate limit"
          },
          "503": {
            "description": "The xo server is misconfigured or busy"
          }
        }
      },
      "patch": {
        "operationId": "update_user_metadata",
        "x-xo-server": true,
        "tags": [
          "users"
        ],
        "summary": "Merge changes into a user's public and private Clerk metadata (admin keys only; xo server)",
        "description": "Clerk deep-merges the objects you send into the stored ones; a key set to null is removed, and {} changes nothing. Only top-level keys the server allow-lists can change. Each bucket holds at most 8KB. Served by an xo server (`xo serve`) at $XO_URL (the default https://xo.quirq.dev), not by XO's platform.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A Clerk user id (user_...)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicMetadata": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "JSON object merged into public metadata (readable by the user's browser)"
                  },
                  "privateMetadata": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "JSON object merged into private metadata (server-only)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "data.publicMetadata, data.privateMetadata after the change"
          },
          "403": {
            "description": "The key is not an XO admin key"
          },
          "404": {
            "description": "No such user"
          },
          "422": {
            "description": "Body is not one or two JSON objects, a key is not editable, userId is not a Clerk user id, or a bucket would pass 8KB"
          },
          "429": {
            "description": "Over the per-key rate limit"
          },
          "503": {
            "description": "The xo server is misconfigured or busy"
          }
        }
      }
    }
  }
}
